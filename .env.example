# PostgreSQL / Supabase. Runtime may use a pooler URL; migrations should use a direct URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repotutor"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repotutor"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub App. The slug is the value in https://github.com/apps/<slug>.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Base64-encoded PEM private key (recommended for hosted environments).
GITHUB_APP_PRIVATE_KEY_BASE64=

# 32 random bytes encoded as base64. Encrypts GitHub user tokens stored by Auth.js.
TOKEN_ENCRYPTION_KEY=

# Optional, server-only token used by the existing anonymous public repository analyzer.
# Never use a NEXT_PUBLIC_ prefix for any secret in this file.
GITHUB_TOKEN=

# Server-only Groq settings for AI learning explanations.
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_TIMEOUT_MS="25000"
